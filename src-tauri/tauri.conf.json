{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentPanel",
  "version": "0.1.0",
  "identifier": "com.jason.agentpanel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentPanel",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jason Robey",
    "copyright": "Copyright © 2026 Jason Robey",
    "category": "DeveloperTool",
    "shortDescription": "Worktree command center for coding agents",
    "longDescription": "AgentPanel runs multiple AI coding agents in parallel, each isolated in its own git worktree with its own terminal — a native Windows command center.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
